<sdf version="1.6">
  <world name="mid360_mapping">
    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" default="1" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Outer boundary: 14 m x 12 m. -->
    <model name="wall_north"><static>true</static><pose>0 6 0.75 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>14 0.2 1.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>14 0.2 1.5</size></box></geometry><material><ambient>0.75 0.75 0.78 1</ambient></material></visual>
    </link></model>
    <model name="wall_south"><static>true</static><pose>0 -6 0.75 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>14 0.2 1.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>14 0.2 1.5</size></box></geometry><material><ambient>0.75 0.75 0.78 1</ambient></material></visual>
    </link></model>
    <model name="wall_east"><static>true</static><pose>7 0 0.75 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.2 12 1.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.2 12 1.5</size></box></geometry><material><ambient>0.75 0.75 0.78 1</ambient></material></visual>
    </link></model>
    <model name="wall_west"><static>true</static><pose>-7 0 0.75 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.2 12 1.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.2 12 1.5</size></box></geometry><material><ambient>0.75 0.75 0.78 1</ambient></material></visual>
    </link></model>

    <!-- Asymmetric interior geometry gives SLAM distinctive scan matches. -->
    <model name="wall_center"><static>true</static><pose>1.8 1.2 0.6 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.25 5.0 1.2</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.25 5.0 1.2</size></box></geometry><material><ambient>0.25 0.55 0.85 1</ambient></material></visual>
    </link></model>
    <model name="wall_northwest"><static>true</static><pose>-2.8 2.8 0.6 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>4.0 0.25 1.2</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>4.0 0.25 1.2</size></box></geometry><material><ambient>0.85 0.45 0.25 1</ambient></material></visual>
    </link></model>
    <model name="wall_southeast"><static>true</static><pose>3.8 -2.5 0.6 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>3.5 0.25 1.2</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>3.5 0.25 1.2</size></box></geometry><material><ambient>0.35 0.75 0.35 1</ambient></material></visual>
    </link></model>

    <model name="pillar_southwest"><static>true</static><pose>-3.5 -2.5 0.65 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.55</radius><length>1.3</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.55</radius><length>1.3</length></cylinder></geometry><material><ambient>0.75 0.25 0.25 1</ambient></material></visual>
    </link></model>
    <model name="pillar_northeast"><static>true</static><pose>4.5 3.5 0.65 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.7</radius><length>1.3</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.7</radius><length>1.3</length></cylinder></geometry><material><ambient>0.65 0.25 0.75 1</ambient></material></visual>
    </link></model>
    <model name="box_west"><static>true</static><pose>-5 1 0.5 0 0 0.35</pose><link name="link">
      <collision name="collision"><geometry><box><size>1.2 1.8 1.0</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1.2 1.8 1.0</size></box></geometry><material><ambient>0.85 0.75 0.2 1</ambient></material></visual>
    </link></model>

    <scene><ambient>0.45 0.45 0.45 1</ambient><background>0.75 0.8 0.9 1</background><shadows>true</shadows></scene>
    <gui fullscreen="0"><camera name="user_camera"><pose>11 -13 10 0 0.55 2.35</pose></camera></gui>
  </world>
</sdf>

Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
      Frame Timeout: 15
      Marker Scale: 0.5
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: false
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: FAST-LIO Odometry
      Topic: /Odometry
      Keep: 1
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: false
      Name: FAST-LIO Path
      Topic: /path
      Buffer Length: 1
      Color: 25; 255; 0
      Line Style: Lines
      Line Width: 0.03
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Registered Cloud
      Enabled: false
      Value: false
      Topic: /cloud_registered
      Queue Size: 1
      Unreliable: false
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Axis: Z
      Autocompute Value Bounds:
        Value: true
      Use rainbow: true
      Alpha: 1
      Decay Time: 0
      Style: Points
      Size (Pixels): 2
      Size (m): 0.005
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Accumulated Room Map
      Enabled: true
      Value: true
      Topic: /Laser_map
      Queue Size: 1
      Unreliable: false
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds:
        Value: true
      Use rainbow: true
      Alpha: 0.8
      Decay Time: 0
      Style: Points
      Size (Pixels): 2
      Size (m): 0.005
      Use Fixed Frame: true
  Enabled: true
  Global Options:
    Background Color: 0; 0; 0
    Fixed Frame: odom
    Frame Rate: 15
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7
      Pitch: 0.55
      Yaw: 0.8
      Focal Point: {X: 0, Y: 0, Z: 0}
      Target Frame: odom
      Name: Current View
Window Geometry:
  Width: 1200
  Height: 800
  X: 40
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: false
